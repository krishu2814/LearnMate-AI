# Application Settings
PROJECT_NAME="LearnMate AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="insecure_dev_secret_key_change_in_production_32bytes_minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (MySQL 8) - Port 3307 on host, overridden to 3306 in docker network
MYSQL_SERVER="mysql"
MYSQL_PORT=3306
MYSQL_USER="learnmate_user"
MYSQL_PASSWORD="learnmate_password"
MYSQL_DB="learnmate_db"

# Redis - Port 6380 on host, overridden to 6379 in docker network
REDIS_HOST="redis"
REDIS_PORT=6379

# Google Gemini API
GEMINI_API_KEY=""
